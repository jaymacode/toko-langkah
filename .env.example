# Copy to .env and fill in. Never commit .env.
APP_ENV=development
DEMO_MODE=false

# --- Supabase project (Project Settings > API and > Database) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Used only by the one-time setup job to create the synthetic accounts. Never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Table owner connection (setup job: migrations and seed).
DATABASE_URL=
# Request-path login for the non-owner role tokolangkah_api (created by migration 0007).
API_DATABASE_URL=

# --- Model provider: any OpenAI-compatible endpoint (https only), e.g. OpenRouter ---
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional, only for RETRIEVAL_MODE=hybrid.
OPENAI_EMBEDDING_MODEL=
# keyword (default) or hybrid.
RETRIEVAL_MODE=keyword
# Spend cap in USD for all model calls; 0 blocks every call. Costs are estimated from the prices below.
LIVE_EVAL_BUDGET_USD=1
OPENAI_PRICE_INPUT_PER_MTOK=0.20
OPENAI_PRICE_OUTPUT_PER_MTOK=1.20
OPENAI_EMBEDDING_PRICE_PER_MTOK=0.02
MAX_TOOL_CALLS=6

ALLOWED_ORIGINS=http://localhost:3000

# --- Browser values (public, baked into the web image at build time) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_MODE=development
# Same project URL and the sb_publishable_ key only (never a secret or service_role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
