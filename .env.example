# Example only. Set secrets through your local environment or deployment secret manager.
APP_ENV=development
DEMO_MODE=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Browser may receive only the publishable key and URL, with correctly configured RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Admin migrations/seed only; do not expose to the app request path.
DATABASE_URL=
# Request-path login for the non-owner role tokolangkah_api (required in production). DATABASE_URL is admin-only.
API_DATABASE_URL=
# Any OpenAI-compatible endpoint (https only). Unset = api.openai.com. Example tested 2026-10-28:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=nvidia/nemotron-3.5-super-vl:free
#   OPENAI_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-8b:free   (requested at 1536 dims)
# OpenRouter :free models log prompts upstream; use them only with synthetic data like this demo.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
ALLOWED_ORIGINS=http://localhost:3000
MAX_TOOL_CALLS=6
# Configure an explicit nonzero budget before live evaluation.
LIVE_EVAL_BUDGET_USD=0
# Conservative cost estimate used by the budget guard (USD per 1M tokens).
OPENAI_PRICE_INPUT_PER_MTOK=0.20
OPENAI_PRICE_OUTPUT_PER_MTOK=1.20
ASSISTANT_PROVIDER=rules
# keyword (default) or hybrid (needs OPENAI_EMBEDDING_MODEL, e.g. text-embedding-3-small, and admin.embed run once).
RETRIEVAL_MODE=keyword
OPENAI_EMBEDDING_PRICE_PER_MTOK=0.02


# Local development database (M0). Values here are local-only defaults, not secrets.
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tokolangkah
POSTGRES_PORT=54322
# Browser-visible values (non-secret). Only publishable keys may ever use NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_MODE=development
# Browser Supabase client: project URL and the sb_publishable_ key only (never sb_secret_/service_role).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
